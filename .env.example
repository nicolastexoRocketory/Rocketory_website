DATABASE_URI=file:./payload.db
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_ADMIN_EMAIL=admin@rocketory.de
PAYLOAD_ADMIN_PASSWORD=Rocketory2026!

# Matomo (self-hosted) — lokal: docker compose -f docker-compose.matomo.yml up -d
# Nach Setup: Site-ID + Auth-Token unter Einstellungen → Persönlich → Sicherheit
MATOMO_URL=http://localhost:8080
MATOMO_SITE_ID=1
MATOMO_AUTH_TOKEN=your-matomo-auth-token
# Öffentlicher Tracker (Frontend, nach Cookie-Einwilligung)
NEXT_PUBLIC_MATOMO_URL=http://localhost:8080
NEXT_PUBLIC_MATOMO_SITE_ID=1
